{
  "name": "claude-live-screen",
  "productName": "Claude Live Screen",
  "version": "0.1.0",
  "description": "Open-source Windows/macOS assistant that lets Claude watch your screen and give live, real-time advice about what's on it.",
  "main": "src/main.js",
  "bin": {
    "claude-live-screen": "bin/cli.js"
  },
  "license": "MIT",
  "author": "Khant Zwe Naing (Issac)",
  "homepage": "https://github.com/jadstrike/claude-live-screen#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jadstrike/claude-live-screen.git"
  },
  "bugs": {
    "url": "https://github.com/jadstrike/claude-live-screen/issues"
  },
  "keywords": [
    "claude",
    "anthropic",
    "screen-capture",
    "ai-assistant",
    "electron",
    "screenshot",
    "developer-tools"
  ],
  "engines": {
    "node": ">=18"
  },
  "files": [
    "src/",
    "bin/",
    "build/icon.png",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "electron .",
    "icon": "node build/make-icon.js",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0"
  },
  "devDependencies": {
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "io.github.jadstrike.claude-live-screen",
    "productName": "Claude Live Screen",
    "copyright": "Copyright © 2026 Khant Zwe Naing",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!bin/**/*",
      "!build/**/*",
      "!node_modules/electron/**/*",
      "!node_modules/electron-builder/**/*"
    ],
    "electronVersion": "37.10.3",
    "publish": [
      {
        "provider": "github",
        "owner": "jadstrike",
        "repo": "claude-live-screen"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "artifactName": "Claude-Live-Screen-${version}-mac-${arch}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": null,
      "extendInfo": {
        "NSScreenCaptureUsageDescription": "Claude Live Screen captures your screen only while you switch screen vision on, so Claude can give advice about what you are looking at."
      }
    },
    "dmg": {
      "title": "Claude Live Screen ${version} ${arch}",
      "writeUpdateInfo": false
    },
    "win": {
      "icon": "build/icon.png",
      "artifactName": "Claude-Live-Screen-Setup-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Claude Live Screen",
      "include": "build/installer.nsh"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Utility",
      "artifactName": "Claude-Live-Screen-${version}-linux-${arch}.${ext}",
      "target": [
        "AppImage"
      ]
    }
  },
  "optionalDependencies": {
    "electron": "^37.0.0"
  }
}
